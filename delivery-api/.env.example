# 聚合配送系统环境变量配置示例
# 复制此文件为 .env 并填写真实配置

# ==================== 美团配送配置 ====================
# 申请地址: https://developer.meituan.com/
MEITUAN_TEST_APP_ID=
MEITUAN_TEST_SECRET=
MEITUAN_PROD_APP_ID=
MEITUAN_PROD_SECRET=

# ==================== 达达/京东秒送配置 ====================
# 申请地址: https://newopen.imdada.cn/
DADA_TEST_APP_KEY=
DADA_TEST_APP_SECRET=
DADA_PROD_APP_KEY=
DADA_PROD_APP_SECRET=

# ==================== 顺丰同城配置 ====================
# 申请地址: https://openic.sf-express.com/
SHUNFENG_TEST_APP_ID=
SHUNFENG_TEST_APP_KEY=
SHUNFENG_TEST_SECRET=
SHUNFENG_PROD_APP_ID=
SHUNFENG_PROD_APP_KEY=
SHUNFENG_PROD_SECRET=

# ==================== 服务器配置 ====================
PORT=3001
NODE_ENV=development

# ==================== 回调配置 ====================
# 回调URL（需要公网可访问）
CALLBACK_BASE_URL=http://your-domain.com:3001
# 回调验证Token
CALLBACK_TOKEN=your-secret-token
