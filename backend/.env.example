# ============================================
# 干洗系统环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================

# ============================================
# MQTT Broker 配置（智能灯条系统）
# ============================================
# MQTT Broker 地址
MQTT_BROKER=mqtt://localhost:1883

# MQTT WebSocket 端口
MQTT_WS_PORT=8083

# MQTT 用户名（默认: admin）
MQTT_USERNAME=admin

# MQTT 密码（默认: public）
MQTT_PASSWORD=public

# MQTT 客户端ID前缀
MQTT_CLIENT_PREFIX=light_

# 心跳间隔（秒）
MQTT_KEEPALIVE=60

# 重连间隔（毫秒）
MQTT_RECONNECT_PERIOD=5000

# ============================================
# 服务器配置
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# 数据库配置
# ============================================
# 数据库类型: mongodb 或 mysql
DB_TYPE=mongodb

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/dry_cleaning

# MySQL 配置（如果使用 MySQL）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=dry_cleaning
MYSQL_SSL=false

# Redis 配置（可选，用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 微信支付配置
# ============================================
WECHAT_APP_ID=your_app_id
WECHAT_MCH_ID=your_merchant_id
WECHAT_API_KEY=your_api_key
WECHAT_API_SECRET=your_api_secret

# 微信收付通配置（支持分账）
WECHAT_PROFIT_SHARING=true
WECHAT_SUB_MCH_ID=your_sub_merchant_id

# ============================================
# 聚合配送配置
# ============================================
# 美团配送
MEITUAN_APP_ID=your_meituan_app_id
MEITUAN_APP_SECRET=your_meituan_app_secret

# 达达配送
DADA_APP_KEY=your_dada_app_key
DADA_APP_SECRET=your_dada_app_secret
DADA_SOURCE_ID=your_source_id

# 顺丰配送
SHUNFENG_APP_ID=your_shunfeng_app_id
SHUNFENG_APP_SECRET=your_shunfeng_app_secret

# ============================================
# 腾讯云短信配置（通知）
# ============================================
TENCENT_SMS_APP_ID=your_sms_app_id
TENCENT_SMS_APP_KEY=your_sms_app_key
TENCENT_SMS_SIGN=干洗系统

# ============================================
# 存储配置
# ============================================
# 腾讯云COS（如果使用）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=your_bucket_name
COS_REGION=ap-guangzhou

# ============================================
# 业务配置
# ============================================
# 模块开关
MODULE_CLEANING_ENABLED=true
MODULE_RECYCLE_ENABLED=false
MODULE_RENTAL_ENABLED=false

# 平台抽佣比例
PLATFORM_COMMISSION_RATE=0.1

# 押金配置
DEFAULT_DEPOSIT_RATIO=1.0
VIP_DEPOSIT_RATIO=0.5

# 履约分数阈值
MIN_FULFILLMENT_SCORE=50
MAX_CANCELLED_ORDERS=3
