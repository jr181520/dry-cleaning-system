{
  "name": "dry-cleaning-backend",
  "version": "1.0.0",
  "description": "干洗系统后端服务 - 渐进式架构",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "frontend": "node frontend-server.js",
    "db:init": "node scripts/initDatabase.js",
    "db:seed": "node scripts/seedData.js",
    "db:reset": "npm run db:init && npm run db:seed",
    "migrate:mysql": "mysql -u root -p dry_cleaning < migrations/001_migrate_to_polymorphic.sql",
    "mqtt:setup": "echo 'MQTT Broker setup guide: See backend/services/MQTT_DEPLOYMENT.md'"
  },
  "keywords": [
    "dry-cleaning",
    "saas",
    "modular",
    "mqtt",
    "iot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aedes": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mongoose": "^8.23.0",
    "mosca": "^2.8.3",
    "mqtt": "^5.15.1",
    "mysql2": "^3.22.2",
    "uuid": "^9.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
