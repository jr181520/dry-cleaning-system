{
  "apps": [
    {
      "name": "dry-cleaning-backend",
      "script": "server.js",
      "cwd": "./backend",
      "watch": false,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "restart_delay": 4000,
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "exp_backoff_restart_delay": 100,
      "max_memory_restart": "500M"
    }
  ]
}
