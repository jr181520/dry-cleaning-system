<view class="container">
  <view class="page-header">
    <text class="page-title">服务项目</text>
  </view>

  <!-- 品类分类（横向滚动） -->
  <view class="category-section">
    <scroll-view scroll-x="true" class="category-scroll">
      <view 
        class="category-item {{selectedCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}" 
        wx:key="id" 
        bindtap="onSelectCategory" 
        data-id="{{item.id}}"
        style="{{selectedCategory === item.id ? 'background:' + item.color + ';color:#fff;border-color:' + item.color + ';' : ''}}"
      >
        <text class="category-name">{{item.icon}} {{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 服务列表 — 不显示价格，价格由门店决定 -->
  <view class="service-list">
    <view class="service-item" wx:for="{{services}}" wx:key="id" bindtap="onServiceDetail" data-id="{{item.id}}">
      <view class="service-icon">{{item.icon}}</view>
      <view class="service-info">
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.desc}}</text>
        <view class="service-footer-row">
          <text class="service-price-hint">门店定价</text>
          <text class="service-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
        </view>
      </view>
      <view class="service-actions">
        <view class="book-btn" catchtap="onBookService" data-id="{{item.id}}">
          <text class="book-text">预约</text>
        </view>
        <view class="service-arrow">
          <text class="arrow-icon">→</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{services.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">该品类暂未上架服务</text>
  </view>
</view>