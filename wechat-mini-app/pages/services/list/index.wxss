.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  background-color: #1e40af;
  color: white;
  padding: 40rpx 30rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

.category-section {
  background-color: white;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e5e5e5;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 24rpx;
  background-color: #f5f5f5;
}

.category-text {
  font-size: 24rpx;
  color: #666;
}

.category-text.active {
  background-color: #1e40af;
  color: white;
}

.service-list {
  padding: 20rpx;
}

.service-item {
  display: flex;
  align-items: center;
  background-color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.service-icon {
  font-size: 80rpx;
  margin-right: 24rpx;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.service-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #e53e3e;
}

.service-arrow {
  margin-left: 20rpx;
  color: #999;
}