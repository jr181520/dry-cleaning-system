<view class="container">
  <!-- 配送地址 -->
  <view class="section">
    <view class="section-header">
      <icon type="success" size="16" color="#7c3aed"/>
      <text class="section-title">配送地址</text>
    </view>
    <view class="address-info">
      <view class="address-row">
        <text class="addr-name">{{contactName || '收货人'}}</text>
        <text class="addr-phone">{{contactPhone || '请填写手机号'}}</text>
      </view>
      <text class="addr-detail">{{address || '请填写收货地址'}}</text>
    </view>
    <button class="edit-btn" size="mini" bindtap="editAddress">编辑</button>
  </view>

  <!-- 商品信息 -->
  <view class="section">
    <view class="section-header">
      <view class="rental-icon">◇</view>
      <text class="section-title">租赁商品</text>
    </view>
    <view class="order-item">
      <image wx:if="{{itemImage}}" src="{{itemImage}}" class="item-img" mode="aspectFill"/>
      <view wx:else class="item-img-placeholder"><text>◇</text></view>
      <view class="item-detail">
        <text class="item-name">{{itemName}}</text>
        <text class="item-spec">{{itemSpec}}</text>
        <view class="item-bottom">
          <text class="item-price">¥{{dailyRate}}/天</text>
          <text class="item-days">x{{rentalDays}}天</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="section">
    <text class="section-title">费用明细</text>
    <view class="fee-row">
      <text class="fee-label">租金 (¥{{dailyRate}}/天 x {{rentalDays}}天)</text>
      <text class="fee-value">¥{{rentalCost}}</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">押金</text>
      <text class="fee-value">¥{{depositAmount}}</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">配送费</text>
      <text class="fee-value">¥0.00</text>
    </view>
    <view class="fee-row total-row">
      <text class="fee-label">合计</text>
      <text class="fee-total">¥{{totalPrice}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="section">
    <text class="section-title">支付方式</text>
    <view class="pay-option active" bindtap="selectPay" data-method="wechat">
      <text class="pay-icon">💚</text>
      <text>微信支付</text>
    </view>
  </view>

  <view style="height: 120rpx;"></view>

  <!-- 底部 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <button class="submit-btn" bindtap="submitOrder">提交订单</button>
  </view>
</view>
