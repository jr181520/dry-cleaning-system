.container { padding-bottom: 20rpx; background: #f8fafc; min-height: 100vh; }
.search-bar { padding: 20rpx 30rpx; }
.search-input-wrap { display: flex; align-items: center; background: #f3f4f6; border-radius: 40rpx; padding: 16rpx 24rpx; gap: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; }

.category-scroll { white-space: nowrap; padding: 0 30rpx 20rpx; }
.category-tabs { display: flex; gap: 16rpx; }
.category-tab { padding: 12rpx 28rpx; border-radius: 30rpx; font-size: 26rpx; background: #f3f4f6; color: #666; flex-shrink: 0; }
.category-tab.active { background: #7c3aed; color: #fff; }

.items-grid { display: flex; flex-wrap: wrap; padding: 0 20rpx; gap: 20rpx; }
.item-card { width: calc(50% - 10rpx); background: #fff; border-radius: 20rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.item-image { position: relative; width: 100%; padding-top: 100%; background: #f3f4f6; }
.item-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.item-placeholder { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.placeholder-icon { font-size: 60rpx; color: #d1d5db; }
.item-tag { position: absolute; top: 12rpx; left: 12rpx; background: #ef4444; color: #fff; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }

.item-info { padding: 16rpx 20rpx 20rpx; }
.item-name { font-size: 26rpx; font-weight: 500; color: #1f2937; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-brand { font-size: 22rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.item-price-row { display: flex; align-items: baseline; margin-top: 12rpx; }
.item-price { font-size: 32rpx; font-weight: bold; color: #ef4444; }
.item-unit { font-size: 22rpx; color: #9ca3af; margin-left: 4rpx; }
.item-deposit-row { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.deposit-badge { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.deposit-deposit { background: #fef3c7; color: #d97706; }
.deposit-credit_free { background: #dbeafe; color: #2563eb; }
.deposit-both { background: #ede9fe; color: #7c3aed; }
.deposit-amount { font-size: 22rpx; color: #9ca3af; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; color: #d1d5db; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #9ca3af; }
.empty-sub { font-size: 24rpx; color: #d1d5db; margin-top: 8rpx; }
.loading-state { text-align: center; padding: 40rpx; color: #9ca3af; font-size: 26rpx; }
