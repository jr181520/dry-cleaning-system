/* pages/login/index.wxss */

/* 容器 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 40%);
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
}

/* 头部区域 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  padding-bottom: 60rpx;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.3);
  margin-bottom: 32rpx;
}

.logo {
  width: 100rpx;
  height: 100rpx;
}

.logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  font-size: 80rpx;
}

.app-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1e40af;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #6b7280;
  letter-spacing: 2rpx;
}

/* 登录方式切换标签 */
.login-method-tabs {
  display: flex;
  gap: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 48rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
}

.tab-item.active .tab-text {
  color: #ffffff;
}

.tab-item.active .tab-icon {
  font-size: 36rpx;
}

.tab-icon {
  font-size: 32rpx;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

/* 微信登录区域 */
.wechat-login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

/* 微信登录协议勾选框 */
.wechat-agreement {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.wechat-agreement-label {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.wechat-checkbox {
  margin-top: 6rpx;
}

.wechat-checkbox .wx-checkbox-input {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #d1d5db;
}

.wechat-checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: #10b981;
  border-color: #10b981;
}

.agreement-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.agreement-prefix {
  color: #6b7280;
}

.agreement-connector {
  color: #6b7280;
}

.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
  border: none;
  padding: 0;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn.loading {
  opacity: 0.7;
}

.wechat-login-btn.disabled {
  background: #e5e7eb;
  box-shadow: none;
}

.wechat-login-btn.disabled .btn-text {
  color: #9ca3af;
}

.btn-icon {
  font-size: 40rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.login-tips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.link-text {
  color: #1e40af;
  font-weight: 500;
}

/* 登录表单 */
.login-form {
  width: 100%;
  display: none;
  flex-direction: column;
  gap: 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s;
}

.login-form.show {
  display: flex;
  opacity: 1;
  transform: translateY(0);
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.label-icon {
  font-size: 32rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.form-input {
  height: 96rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2937;
  transition: border-color 0.3s;
}

.form-input:focus {
  border-color: #1e40af;
}

.form-input::placeholder {
  color: #9ca3af;
}

.input-with-btn {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input-with-btn .form-input {
  flex: 1;
}

.send-code-btn {
  width: 200rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  border: none;
  padding: 0;
}

.send-code-btn::after {
  border: none;
}

.send-code-btn.disabled {
  background: #e5e7eb;
  color: #9ca3af;
}

.input-with-icon {
  position: relative;
  display: flex;
  align-items: center;
}

.input-with-icon .form-input {
  padding-right: 80rpx;
}

.toggle-password {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx;
}

.toggle-password .icon {
  font-size: 36rpx;
}

/* 用户协议 */
.agreement-section {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.agreement-text {
  color: #6b7280;
}

checkbox .wx-checkbox-input {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(30, 64, 175, 0.3);
  border: none;
  padding: 0;
  margin-top: 16rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn.loading {
  opacity: 0.7;
}

.submit-btn[disabled] {
  background: #e5e7eb;
  box-shadow: none;
}

.submit-btn[disabled] .btn-text {
  color: #9ca3af;
}

/* 底部区域 */
.bottom-section {
  margin-top: auto;
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.toggle-mode {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.toggle-text {
  font-size: 28rpx;
  color: #6b7280;
}

.toggle-btn {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e40af;
}

.guest-access {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.guest-text {
  padding: 8rpx 16rpx;
}

.guest-split {
  color: #d1d5db;
}
