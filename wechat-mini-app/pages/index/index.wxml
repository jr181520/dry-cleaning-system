<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索干洗服务...</text>
    </view>
    <view class="notification-btn">
      <text class="notification-icon">🔔</text>
      <view class="notification-dot" wx:if="{{pendingOrders.length > 0}}"></view>
    </view>
  </view>

  <!-- Banner区域 -->
  <view class="banner">
    <swiper class="banner-swiper" indicator-dots indicator-color="rgba(255,255,255,0.3)" indicator-active-color="#ffffff" autoplay interval="4000" circular>
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-item">
          <view class="banner-content">
            <text class="banner-title">{{item.title}}</text>
            <view class="banner-action">
              <text class="banner-btn">立即体验</text>
            </view>
          </view>
          <view class="banner-gradient"></view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-entry">
    <view class="entry-grid">
      <view class="entry-item enhanced" bindtap="onQuickOrder">
        <view class="entry-icon-wrapper bg-gradient-green">
          <text class="entry-icon">📦</text>
        </view>
        <text class="entry-text">线上下单</text>
        <view class="entry-subtext">快速便捷</view>
      </view>
      <view class="entry-item enhanced" bindtap="onQuickPickup">
        <view class="entry-icon-wrapper bg-gradient-blue">
          <text class="entry-icon">📱</text>
        </view>
        <text class="entry-text">扫码取件</text>
        <view class="entry-subtext">一扫即取</view>
      </view>
      <view class="entry-item enhanced" bindtap="onMyOrders">
        <view class="entry-icon-wrapper bg-gradient-purple">
          <text class="entry-icon">📋</text>
        </view>
        <text class="entry-text">我的订单</text>
        <view class="entry-subtext">随时查看</view>
      </view>
      <view class="entry-item enhanced" bindtap="onMembership">
        <view class="entry-icon-wrapper bg-gradient-orange">
          <text class="entry-icon">👑</text>
        </view>
        <text class="entry-text">会员中心</text>
        <view class="entry-subtext">专属权益</view>
      </view>
    </view>
  </view>

  <!-- 待取件通知 -->
  <view class="pending-notice" wx:if="{{pendingOrders.length > 0}}">
    <view class="notice-card">
      <view class="notice-badge">
        <text class="badge-icon">📦</text>
        <text class="badge-count">{{pendingOrders.length}}</text>
      </view>
      <view class="notice-content">
        <text class="notice-title">您有 {{pendingOrders.length}} 件待取件</text>
        <view class="notice-orders">
          <view class="order-preview" wx:for="{{pendingOrders}}" wx:key="id" wx:for-item="order" bindtap="onViewOrder" data-id="{{order.id}}">
            <text class="order-id">{{order.orderId}}</text>
            <text class="order-time">{{order.time}}</text>
          </view>
        </view>
      </view>
      <view class="notice-action" bindtap="onQuickPickup">
        <text class="action-text">取件</text>
        <text class="action-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 服务项目 -->
  <view class="services">
    <view class="section-header">
      <view class="section-title-wrapper">
        <text class="section-icon">✨</text>
        <text class="section-title">热门服务</text>
      </view>
      <view class="section-more" bindtap="onViewAllServices">
        <text class="more-text">查看全部</text>
        <text class="more-arrow">→</text>
      </view>
    </view>
    <view class="service-grid">
      <view class="service-item" wx:for="{{services}}" wx:key="id" bindtap="onSelectService" data-id="{{item.id}}">
        <view class="service-card">
          <view class="service-icon-wrapper">
            <text class="service-icon">{{item.icon}}</text>
          </view>
          <view class="service-info">
            <text class="service-name">{{item.name}}</text>
            <text class="service-desc">{{item.desc}}</text>
          </view>
          <view class="service-footer">
            <text class="service-price">¥{{item.price}}</text>
            <view class="service-btn">
              <text class="btn-text">预约</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 附近门店 -->
  <view class="nearby-stores">
    <view class="section-header">
      <view class="section-title-wrapper">
        <text class="section-icon">📍</text>
        <text class="section-title">附近门店</text>
      </view>
      <view class="section-more" bindtap="onViewAllStores">
        <text class="more-text">查看全部</text>
        <text class="more-arrow">→</text>
      </view>
    </view>
    <view class="store-list">
      <view class="store-item {{selectedStoreId === item.id ? 'selected' : ''}}" wx:for="{{nearbyStores}}" wx:key="id" bindtap="onSelectStore" data-id="{{item.id}}">
        <view class="store-main">
          <view class="store-header">
            <view class="store-title-row">
              <text class="store-name">{{item.name}}</text>
              <view class="store-status" wx:if="{{item.isOnline}}">
                <view class="status-dot"></view>
                <text class="status-text">营业中</text>
              </view>
            </view>
            <view class="store-distance-row">
              <text class="distance-icon">📍</text>
              <text class="store-distance">{{item.distance}}</text>
            </view>
          </view>
          <view class="store-address-row">
            <text class="store-address">{{item.address}}</text>
          </view>
          <view class="store-meta-row">
            <view class="store-tags">
              <view class="tag promotion" wx:if="{{item.isPromotion}}">
                <text class="tag-icon">🔥</text>
                <text class="tag-text">促销中</text>
              </view>
              <view class="tag recommended" wx:if="{{item.isRecommended}}">
                <text class="tag-icon">⭐</text>
                <text class="tag-text">推荐</text>
              </view>
            </view>
            <view class="store-stats">
              <text class="stat-item">{{item.serviceCount}}项服务</text>
              <text class="stat-divider">|</text>
              <text class="stat-item min-price">¥{{item.minPrice}}起</text>
            </view>
          </view>
        </view>
        <view class="store-action">
          <view class="action-btn" catchtap="onContact">
            <text class="action-icon">📞</text>
          </view>
          <view class="select-indicator" wx:if="{{selectedStoreId === item.id}}">
            <text class="check-icon">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>
</view>
