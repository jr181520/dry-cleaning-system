/* pages/order/create/index.wxss */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 180rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  padding: 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
}

.header-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 品类选择标签 */
.category-tabs-section {
  background: #ffffff;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-scroll {
  white-space: nowrap;
  display: flex;
}

.category-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 20rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #f3f4f6;
  min-width: 100rpx;
  transition: all 0.25s;
}

.category-tab.active {
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  transform: scale(1.04);
}

.category-tab .tab-icon {
  font-size: 44rpx;
  transition: transform 0.25s;
}

.category-tab.active .tab-icon {
  transform: scale(1.1);
}

.category-tab .tab-name {
  font-size: 22rpx;
  font-weight: 600;
}

/* 服务列表 */
.services-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.service-card.selected {
  border-color: #3b82f6;
  box-shadow: 0 4rpx 20rpx rgba(59, 130, 246, 0.15);
}

.service-card:active {
  transform: scale(0.99);
}

.service-main {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.service-icon {
  font-size: 56rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.service-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.4;
}

.service-unit {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  width: fit-content;
  margin-top: 8rpx;
}

.service-deposit {
  font-size: 24rpx;
  color: #f97316;
  font-weight: 600;
  flex: 1;
  text-align: center;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.service-price-hint {
  font-size: 24rpx;
  color: #9ca3af;
}

.service-checkbox {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.service-checkbox.checked {
  background: #3b82f6;
  border-color: #3b82f6;
}

.check-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

/* 底部摘要栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.bar-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.selected-summary {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #6b7280;
}

.summary-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #3b82f6;
}

.summary-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

.next-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #e5e7eb;
  padding: 28rpx 48rpx;
  border-radius: 28rpx;
  transition: all 0.3s;
}

.next-btn.active {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  box-shadow: 0 4rpx 16rpx rgba(30, 64, 175, 0.3);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.next-btn:not(.active) .btn-text {
  color: #9ca3af;
}

.btn-arrow {
  font-size: 28rpx;
  color: #ffffff;
}

.next-btn:not(.active) .btn-arrow {
  color: #9ca3af;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 底部安全区 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* ========== 寄养详情弹窗 ========== */
.boarding-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.boarding-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 201;
  max-height: 85vh;
  overflow-y: auto;
}

.boarding-modal-header {
  margin-bottom: 32rpx;
  text-align: center;
}

.boarding-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
}

.boarding-modal-sub {
  font-size: 24rpx;
  color: #9ca3af;
}

.boarding-field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  display: block;
  margin-bottom: 16rpx;
}

.pet-type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.pet-type-item {
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.pet-type-item.active {
  background: #eff6ff;
  border-color: #3b82f6;
}

.pet-type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.pet-type-item.active .pet-type-name {
  color: #1e40af;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.days-counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.days-btn {
  width: 72rpx;
  height: 72rpx;
  background: #f3f4f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.days-btn:active {
  background: #e5e7eb;
  transform: scale(0.95);
}

.days-btn-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #374151;
}

.days-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e40af;
  min-width: 100rpx;
  text-align: center;
}

.food-options {
  display: flex;
  gap: 16rpx;
}

.food-option {
  flex: 1;
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.food-option.active {
  background: #eff6ff;
  border-color: #3b82f6;
}

.food-option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  display: block;
  margin-bottom: 6rpx;
}

.food-option-desc {
  font-size: 22rpx;
  color: #9ca3af;
}

.boarding-confirm {
  margin-top: 40rpx;
}

.boarding-confirm-btn {
  width: 100%;
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  padding: 28rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(30, 64, 175, 0.3);
}

.boarding-confirm-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.confirm-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}
