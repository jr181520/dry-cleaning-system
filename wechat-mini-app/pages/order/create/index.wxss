/* pages/order/create/index.wxss */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 180rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  padding: 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
}

.header-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 服务列表 */
.services-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.service-card.selected {
  border-color: #3b82f6;
  box-shadow: 0 4rpx 20rpx rgba(59, 130, 246, 0.15);
}

.service-card:active {
  transform: scale(0.99);
}

.service-main {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.service-icon {
  font-size: 56rpx;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.service-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.4;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.service-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
}

.service-checkbox {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.service-checkbox.checked {
  background: #3b82f6;
  border-color: #3b82f6;
}

.check-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

/* 底部摘要栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.bar-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.selected-summary {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #6b7280;
}

.summary-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ef4444;
}

.next-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #e5e7eb;
  padding: 28rpx 48rpx;
  border-radius: 28rpx;
  transition: all 0.3s;
}

.next-btn.active {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
  box-shadow: 0 4rpx 16rpx rgba(30, 64, 175, 0.3);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.next-btn:not(.active) .btn-text {
  color: #9ca3af;
}

.btn-arrow {
  font-size: 28rpx;
  color: #ffffff;
}

.next-btn:not(.active) .btn-arrow {
  color: #9ca3af;
}

/* 底部安全区 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
