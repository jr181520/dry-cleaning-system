<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="header-content">
      <text class="page-title">订单支付</text>
      <view class="countdown-bar">
        <text class="countdown-label">剩余支付时间</text>
        <text class="countdown-time">{{formatCountdown(countdown)}}</text>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info" wx:if="{{orderData}}">
    <view class="info-card">
      <view class="info-header">
        <text class="info-icon">🏪</text>
        <text class="info-title {{!orderData.store ? 'auto-assigned' : ''}}">
          {{orderData.store ? orderData.store.name : '系统自动分配门店'}}
        </text>
      </view>
      <view class="info-details">
        <view class="detail-item">
          <text class="item-label">服务项目</text>
          <text class="item-value">{{orderData.services.length}}项</text>
        </view>
        <view class="detail-item">
          <text class="item-label">取件方式</text>
          <text class="item-value">{{orderData.deliveryMethod === 'pickup' ? '自送到店' : '跑腿上门取件'}}</text>
        </view>
        <view class="detail-item" wx:if="{{orderData.deliveryMethod === 'courier'}}">
          <text class="item-label">配送服务商</text>
          <text class="item-value">{{orderData.provider.name}}</text>
        </view>
        <view class="detail-item">
          <text class="item-label">预约时间</text>
          <text class="item-value">{{orderData.time.text}}</text>
        </view>
        <view class="detail-item" wx:if="{{orderData.store}}">
          <text class="item-label">门店地址</text>
          <text class="item-value address">{{orderData.store.address}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单号 -->
  <view class="order-id-section">
    <view class="order-id-card">
      <text class="id-label">订单编号</text>
      <text class="id-value">{{orderId}}</text>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="fee-section">
    <view class="section-header">
      <text class="section-title">费用明细</text>
      <view class="view-detail" bindtap="onViewOrderDetail">
        <text class="detail-text">订单详情</text>
        <text class="detail-arrow">→</text>
      </view>
    </view>
    <view class="fee-card">
      <view class="fee-row">
        <text class="fee-label">门店服务费</text>
        <text class="fee-value">¥{{orderData.fees.storeFee}}</text>
      </view>
      <view class="fee-row" wx:if="{{orderData.fees.discount > 0}}">
        <text class="fee-label">自取折扣</text>
        <text class="fee-discount">-¥{{orderData.fees.discount}}</text>
      </view>
      <view class="fee-row" wx:if="{{orderData.fees.deliveryFee > 0}}">
        <text class="fee-label">配送费</text>
        <text class="fee-value">¥{{orderData.fees.deliveryFee}}</text>
      </view>
      <view class="fee-divider"></view>
      <view class="fee-row total">
        <text class="fee-label">应付金额</text>
        <text class="fee-total">¥{{orderData.fees.totalAmount}}</text>
      </view>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="payment-section">
    <view class="section-header">
      <text class="section-title">选择支付方式</text>
    </view>
    <view class="payment-list">
      <view 
        class="payment-item {{selectedPaymentMethod === item.id ? 'selected' : ''}}"
        wx:for="{{paymentMethods}}"
        wx:key="id"
        bindtap="onSelectPayment"
        data-id="{{item.id}}"
      >
        <view class="payment-radio">
          <view class="radio-outer">
            <view class="radio-inner" wx:if="{{selectedPaymentMethod === item.id}}"></view>
          </view>
        </view>
        <view class="payment-icon">{{item.iconEmoji}}</view>
        <view class="payment-info">
          <text class="payment-name">{{item.name}}</text>
          <text class="payment-desc">{{item.desc}}</text>
        </view>
        <view class="payment-balance" wx:if="{{item.id === 'balance'}}">
          <text class="balance-value">¥{{userBalance}}</text>
        </view>
        <view class="payment-balance" wx:if="{{item.id === 'member'}}">
          <text class="balance-value">¥{{memberBalance}}</text>
        </view>
        <view class="recommended-tag" wx:if="{{item.recommended}}">
          <text class="tag-text">推荐</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 会员积分提示 -->
  <view class="points-section" wx:if="{{orderData}}">
    <view class="points-card">
      <text class="points-icon">⭐</text>
      <view class="points-info">
        <text class="points-title">支付完成后可获得</text>
        <text class="points-value">{{Math.floor(orderData.fees.totalAmount / 10) * 10}} 积分</text>
      </view>
    </view>
  </view>

  <!-- 底部支付栏 -->
  <view class="pay-bar">
    <view class="pay-content">
      <view class="pay-amount">
        <text class="amount-label">实付金额</text>
        <text class="amount-value">¥{{orderData.fees.totalAmount}}</text>
      </view>
      <view 
        class="pay-btn {{isPaying ? 'paying' : ''}}"
        bindtap="onConfirmPayment"
      >
        <text class="btn-text">{{isPaying ? '支付中...' : '确认支付'}}</text>
      </view>
    </view>
  </view>

  <!-- 取消订单按钮 -->
  <view class="cancel-bar">
    <text class="cancel-btn" bindtap="onCancelOrder">取消订单</text>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>
</view>
