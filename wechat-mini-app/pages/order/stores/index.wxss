/* pages/order/stores/index.wxss — 智慧大脑推荐引擎 */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
}

.header-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 已选服务简要提示 */
.selected-services-hint {
  margin: 20rpx 24rpx;
  padding: 18rpx 24rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #3b82f6;
}

.hint-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.hint-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #3b82f6;
}

/* ========== 推荐选项卡 Tab Bar ========== */
.recommend-tabs-bar {
  display: flex;
  margin: 20rpx 24rpx 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.recommend-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
  position: relative;
}

.recommend-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.tab-icon-text {
  font-size: 28rpx;
}

.tab-label-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #6b7280;
}

.recommend-tab.active .tab-label-text {
  color: #ffffff;
  font-weight: 600;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  margin-bottom: 16rpx;
}

.filter-actions {
  display: flex;
  gap: 24rpx;
}

.filter-checkbox {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.filter-text {
  font-size: 24rpx;
  color: #6b7280;
}

.filter-count {
  font-size: 22rpx;
  color: #9ca3af;
}

checkbox .wx-checkbox-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 500;
}

/* 错误提示 */
.error-hint {
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #fef3c7;
  border-radius: 12rpx;
}

.error-text {
  font-size: 24rpx;
  color: #92400e;
}

/* 门店列表 */
.store-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.store-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.3s, box-shadow 0.3s;
}

.store-card.offline {
  opacity: 0.65;
}

.store-card:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.store-main {
  margin-bottom: 24rpx;
}

.store-header {
  margin-bottom: 16rpx;
}

.store-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.store-id-badge {
  font-size: 20rpx;
  color: #667eea;
  background: #eff6ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.store-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.store-status.online {
  background: #dcfce7;
  color: #10b981;
}

.store-status.offline {
  background: #f3f4f6;
  color: #9ca3af;
}

.status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.store-rating-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rating-stars {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.star {
  font-size: 24rpx;
}

.rating-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #f59e0b;
}

.store-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 600;
}

.store-location {
  margin-bottom: 16rpx;
}

.location-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.location-icon {
  font-size: 24rpx;
  margin-top: 2rpx;
}

.location-text {
  font-size: 26rpx;
  color: #6b7280;
  flex: 1;
  line-height: 1.4;
}

.store-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag.promotion {
  background: #fee2e2;
  color: #ef4444;
}

.tag.recommended {
  background: #dbeafe;
  color: #667eea;
}

.tag-icon {
  font-size: 20rpx;
}

.store-pricing-breakdown {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.pricing-header {
  margin-bottom: 12rpx;
}

.pricing-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.pricing-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.pricing-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pricing-item-left {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.pricing-item-name {
  font-size: 24rpx;
  color: #6b7280;
}

.pricing-item-boarding {
  font-size: 20rpx;
  color: #9ca3af;
}

.pricing-item-price {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
}

.pricing-promo-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-top: 1rpx solid #e5e7eb;
}

.promo-label,
.promo-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #10b981;
}

.pricing-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0 0 0;
  border-top: 1rpx solid #e5e7eb;
  margin-top: 8rpx;
}

.total-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.total-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #ef4444;
}

.pricing-delivery-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #f3f4f6;
}

.delivery-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.delivery-value {
  font-size: 22rpx;
  color: #9ca3af;
}

.no-pricing {
  padding: 24rpx;
  text-align: center;
  background: #f9fafb;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.no-pricing-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 门店操作 */
.store-actions {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f9fafb;
  border-radius: 14rpx;
  transition: background 0.3s;
}

.action-btn:active {
  background: #e5e7eb;
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.select-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.select-btn.disabled {
  background: #e5e7eb;
  box-shadow: none;
}

.select-btn.disabled .btn-text {
  color: #9ca3af;
}

.select-btn.disabled .btn-arrow {
  color: #9ca3af;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.btn-arrow {
  font-size: 24rpx;
  color: #ffffff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.empty-sub {
  font-size: 24rpx;
  color: #d1d5db;
}

/* 列表底部 */
.list-footer {
  padding: 32rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 底部安全区 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* 暂不选择门店按钮 */
.skip-section {
  padding: 32rpx;
  padding-top: 0;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.skip-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
  border: 2rpx dashed #d1d5db;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.skip-button:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
  border-color: #9ca3af;
}

.skip-icon {
  font-size: 32rpx;
}

.skip-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #4b5563;
}

.skip-hint {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}