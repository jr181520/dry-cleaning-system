/* 订单详情页样式 */
.order-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 扫码支付横幅 */
.scan-pay-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx;
  padding-top: calc(30rpx + env(safe-area-inset-top));
  z-index: 1000;
  box-shadow: 0 4rpx 24rpx rgba(102, 126, 234, 0.3);
}

.banner-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.banner-icon {
  font-size: 80rpx;
}

.banner-text {
  flex: 1;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.banner-amount {
  font-size: 56rpx;
  font-weight: 700;
  font-family: monospace;
}

.banner-actions {
  display: flex;
  gap: 20rpx;
}

.banner-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 44rpx;
  border: none;
  font-weight: 600;
  font-size: 28rpx;
  text-align: center;
}

.banner-btn-primary {
  background: white;
  color: #667eea;
}

.banner-btn-secondary {
  background: rgba(255, 255, 255, 0.2);
  color: white;
}

.banner-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
}

/* 顶部状态卡片 */
.status-card {
  position: relative;
  padding: 30rpx 30rpx 50rpx;
  color: white;
}

.home-btn {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
}

.status-icon-large {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  font-size: 56rpx;
}

.status-text {
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 28rpx;
  text-align: center;
  opacity: 0.9;
}

.live-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  background: #4caf50;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.2); }
}

/* 配送员信息 */
.driver-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: -30rpx 30rpx 30rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.driver-avatar {
  width: 96rpx;
  height: 96rpx;
  background: #2196f3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 40rpx;
}

.driver-info {
  flex: 1;
}

.driver-name {
  font-weight: 600;
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.driver-status {
  font-size: 26rpx;
  color: #666;
}

.driver-actions {
  display: flex;
  gap: 20rpx;
}

.driver-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: white;
}

.driver-btn.call {
  background: #4caf50;
}

.driver-btn.message {
  background: #2196f3;
}

/* 进度条 */
.progress-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 30rpx;
}

.info-title {
  font-weight: 600;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  position: relative;
  padding: 0 10rpx;
}

.progress-line {
  position: absolute;
  top: 32rpx;
  left: 60rpx;
  right: 60rpx;
  height: 6rpx;
  background: #e0e0e0;
}

.progress-line-fill {
  position: absolute;
  top: 32rpx;
  left: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.5s ease;
}

.progress-step {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}

.step-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  transition: all 0.3s;
}

.progress-step.active .step-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.progress-step.current .step-icon {
  width: 72rpx;
  height: 72rpx;
  font-size: 32rpx;
  box-shadow: 0 0 0 8rpx rgba(102, 126, 234, 0.2);
}

.step-label {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.progress-step.active .step-label {
  color: #333;
  font-weight: 500;
}

/* 取件码 */
.pickup-code-section {
  background: linear-gradient(135deg, #ff9800, #ff5722);
  color: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
  text-align: center;
}

.pickup-code-label {
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.pickup-code-value {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  font-family: monospace;
}

/* 取件方式选择 */
.pickup-method-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
}

.pickup-method-title {
  font-weight: 600;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  color: #333;
}

.pickup-method-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s;
}

.pickup-method-option.selected {
  border-color: #667eea;
  background: #f5f7ff;
}

.pickup-method-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.pickup-method-info {
  flex: 1;
}

.pickup-method-name {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.pickup-method-desc {
  font-size: 24rpx;
  color: #666;
}

.pickup-method-check {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
}

.pickup-method-option.selected .pickup-method-check {
  background: #667eea;
  border-color: #667eea;
}

/* 配送表单 */
.delivery-form {
  display: none;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
}

.delivery-form.show {
  display: block;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 订单信息卡片 */
.info-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  color: #666;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.mt-3 {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 物品列表 */
.item-list {
  margin-top: 20rpx;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.item-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  margin-right: 24rpx;
  font-size: 36rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
}

/* 门店操作按钮 */
.store-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.store-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333;
}

/* 动态时间线 */
.timeline {
  margin-top: 20rpx;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  padding-bottom: 32rpx;
  position: relative;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 48rpx;
  bottom: 0;
  width: 4rpx;
  background: #e0e0e0;
}

.timeline-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  flex-shrink: 0;
}

.timeline-item.active .timeline-dot {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.timeline-content {
  flex: 1;
}

.timeline-title {
  font-weight: 600;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: 750px;
  margin: 0 auto;
  background: white;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.1);
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  z-index: 100;
}

.btn-action {
  padding: 20rpx 48rpx;
  border-radius: 44rpx;
  border: none;
  font-weight: 600;
  font-size: 28rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-outline {
  background: white;
  border: 4rpx solid #667eea;
  color: #667eea;
}

.btn-success {
  background: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%);
  color: white;
}
