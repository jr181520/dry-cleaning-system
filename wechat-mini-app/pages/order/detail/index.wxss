/* 订单详情页样式 */
.order-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 280rpx;
}

/* 扫码支付横幅 */
.scan-pay-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx;
  padding-top: calc(30rpx + env(safe-area-inset-top));
  z-index: 1000;
  box-shadow: 0 4rpx 24rpx rgba(102, 126, 234, 0.3);
}

.banner-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.banner-icon {
  font-size: 80rpx;
}

.banner-text {
  flex: 1;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.banner-amount {
  font-size: 56rpx;
  font-weight: 700;
  font-family: monospace;
}

.banner-actions {
  display: flex;
  gap: 20rpx;
}

.banner-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 44rpx;
  border: none;
  font-weight: 600;
  font-size: 28rpx;
  text-align: center;
}

.banner-btn-primary {
  background: white;
  color: #667eea;
}

.banner-btn-secondary {
  background: rgba(255, 255, 255, 0.2);
  color: white;
}

.banner-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
}

/* 顶部状态卡片 */
.status-card {
  position: relative;
  padding: 30rpx 30rpx 50rpx;
  color: white;
}

.home-btn {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
}

.status-icon-large {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  font-size: 56rpx;
}

.status-text {
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 28rpx;
  text-align: center;
  opacity: 0.9;
}

.live-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  background: #4caf50;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.2); }
}

/* 配送员信息 */
.driver-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: -30rpx 30rpx 30rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 已入库专属卡片 */
.warehouse-section {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: -30rpx 30rpx 30rpx;
  box-shadow: 0 4rpx 24rpx rgba(124, 58, 237, 0.15);
  border-left: 8rpx solid #7c3aed;
}

.warehouse-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.warehouse-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f3e8ff, #e9d5ff);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.warehouse-title-section {
  flex: 1;
}

.warehouse-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6d28d9;
  margin-bottom: 6rpx;
}

.warehouse-subtitle {
  font-size: 24rpx;
  color: #9ca3af;
}

.warehouse-info {
  margin-bottom: 20rpx;
}

.warehouse-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.warehouse-label {
  font-size: 26rpx;
  color: #6b7280;
}

.warehouse-value {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.warehouse-status-badge {
  text-align: center;
  background: #fefce8;
  border: 1rpx solid #fde68a;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #a16207;
}

.driver-avatar {
  width: 96rpx;
  height: 96rpx;
  background: #2196f3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 40rpx;
}

.driver-info {
  flex: 1;
}

.driver-name {
  font-weight: 600;
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.driver-status {
  font-size: 26rpx;
  color: #666;
}

.driver-actions {
  display: flex;
  gap: 20rpx;
}

.driver-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: white;
}

.driver-btn.call {
  background: #4caf50;
}

.driver-btn.message {
  background: #2196f3;
}

/* 进度条 */
.progress-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 30rpx;
}

.info-title {
  font-weight: 600;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  position: relative;
  padding: 0 10rpx;
}

.progress-line {
  position: absolute;
  top: 32rpx;
  left: 60rpx;
  right: 60rpx;
  height: 6rpx;
  background: #e0e0e0;
}

.progress-line-fill {
  position: absolute;
  top: 32rpx;
  left: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.5s ease;
}

.progress-step {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}

.step-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  transition: all 0.3s;
}

.progress-step.active .step-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.progress-step.current .step-icon {
  width: 72rpx;
  height: 72rpx;
  font-size: 32rpx;
  box-shadow: 0 0 0 8rpx rgba(102,126,234,0.2);
}

.step-label {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.progress-step.active .step-label {
  color: #333;
  font-weight: 500;
}

/* 取件码 */
.pickup-code-section {
  background: linear-gradient(135deg, #ff9800, #ff5722);
  color: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
  text-align: center;
}

.pickup-code-label {
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.pickup-code-value {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  font-family: monospace;
}

/* 取件方式选择 */
.pickup-method-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
}

.pickup-method-title {
  font-weight: 600;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  color: #333;
}

.pickup-method-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s;
}

.pickup-method-option.selected {
  border-color: #667eea;
  background: #f5f7ff;
}

.pickup-method-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.pickup-method-info {
  flex: 1;
}

.pickup-method-name {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.pickup-method-desc {
  font-size: 24rpx;
  color: #666;
}

.pickup-method-check {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
}

.pickup-method-option.selected .pickup-method-check {
  background: #667eea;
  border-color: #667eea;
}

/* 配送表单 */
.delivery-form {
  display: none;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
}

.delivery-form.show {
  display: block;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 订单信息卡片 */
.info-section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  color: #666;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.mt-3 {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 物品列表 */
.item-list {
  margin-top: 20rpx;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.item-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  margin-right: 24rpx;
  font-size: 36rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
}

/* 门店操作按钮 */
.store-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.store-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333;
}

/* 动态时间线 */
.timeline {
  margin-top: 20rpx;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  padding-bottom: 32rpx;
  position: relative;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 48rpx;
  bottom: 0;
  width: 4rpx;
  background: #e0e0e0;
}

.timeline-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  flex-shrink: 0;
}

.timeline-item.active .timeline-dot {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.timeline-content {
  flex: 1;
}

.timeline-title {
  font-weight: 600;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: 750px;
  margin: 0 auto;
  background: white;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.bottom-bar-left,
.bottom-bar-right {
  display: flex;
  gap: 16rpx;
}

.bottom-bar-right {
  justify-content: flex-end;
}

.btn-action {
  padding: 16rpx 32rpx;
  border-radius: 44rpx;
  border: none;
  font-weight: 600;
  font-size: 26rpx;
  line-height: 1.4;
  margin: 0;
  min-height: 64rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-outline {
  background: white;
  border: 2rpx solid #667eea;
  color: #667eea;
}

.btn-success {
  background: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%);
  color: white;
}

.btn-danger {
  border-color: #f44336 !important;
  color: #f44336 !important;
}

.btn-warning {
  border-color: #ff9800 !important;
  color: #ff9800 !important;
}

/* ===== 内嵌支付面板 ===== */
.pay-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
}

.pay-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 199;
}

.pay-panel-inner {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
}

.pay-amount-section {
  text-align: center;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 28rpx;
}

.pay-amount-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.pay-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.pay-amount-symbol {
  font-size: 36rpx;
  font-weight: 700;
  color: #e53935;
  margin-right: 4rpx;
}

.pay-amount-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #e53935;
  line-height: 1;
}

/* 支付方式快捷选择 */
.pay-methods-quick {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.pay-method-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 20rpx;
  background: #fafafa;
  transition: all 0.3s;
  position: relative;
}

.pay-method-item.selected {
  border-color: #4caf50;
  background: #f1f8f1;
}

.pay-method-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.wechat-icon { background: #e8f5e9; }
.balance-icon { background: #fff3e0; }
.alipay-icon { background: #e3f2fd; }
.unionpay-icon { background: #fce4ec; }

.pay-method-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.pay-method-check {
  width: 36rpx;
  height: 36rpx;
  background: #4caf50;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 更多支付方式 */
.pay-methods-more {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 展开/收起 */
.pay-toggle-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0 28rpx;
  font-size: 24rpx;
  color: #999;
}

.toggle-arrow {
  font-size: 20rpx;
  transition: transform 0.3s;
}

.toggle-arrow.up {
  transform: rotate(180deg);
}

/* 确认支付按钮 */
.pay-confirm-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.35);
  transition: all 0.3s;
}

.pay-confirm-btn.paying {
  background: #e0e0e0;
  box-shadow: none;
  color: #999;
}

.pay-confirm-btn::after {
  border: none;
}

/* ============================================ */
/* 灯条管理窗口样式 */
/* ============================================ */

/* 遮罩 */
.light-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 300;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.light-panel-mask.show {
  opacity: 1;
  pointer-events: auto;
}

/* 面板主体 */
.light-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 301;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.light-panel.show {
  transform: translateY(0);
}

/* 拖拽手柄 */
.light-panel-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
}

/* 标题栏 */
.light-panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 30rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.light-panel-title {
  display: flex;
  flex-direction: column;
}

.light-panel-title text:first-child {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.light-panel-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.light-panel-close {
  width: 56rpx;
  height: 56rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

/* 流程引导 */
.light-flow-guide {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 30rpx;
  background: #f8f9ff;
  border-radius: 16rpx;
  flex-wrap: wrap;
}

.flow-step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #666;
}

.flow-step-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}

.flow-step-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-top: -16rpx;
}

/* 一键点亮按钮 */
.light-all-section {
  padding: 0 30rpx;
  margin-bottom: 16rpx;
}

.light-all-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.light-all-btn[disabled] {
  opacity: 0.7;
}

.light-all-btn.all-lit {
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.light-all-btn.completed {
  background: #e0e0e0;
  color: #999;
  box-shadow: none;
}

.light-all-btn::after {
  border: none;
}

/* ============================================ */
/* 跑腿服务商选择面板 */
/* ============================================ */
.courier-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 150;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.courier-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.courier-panel {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 151;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.35s ease;
}
.courier-panel.show {
  transform: translateY(0);
}

.courier-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.courier-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.courier-panel-close {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 24rpx;
  color: #999;
}

/* 配送模式切换 */
.courier-mode-tabs {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 30rpx;
  flex-shrink: 0;
}
.courier-mode-tab {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}
.courier-mode-tab.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
}
.courier-mode-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}
.courier-mode-tab.active .courier-mode-name { color: #fff; }
.courier-mode-sub {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.courier-mode-tab.active .courier-mode-sub { color: rgba(255,255,255,0.7); }

/* 加载 */
.courier-loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}
.courier-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: cp-spin 0.8s linear infinite;
  margin: 0 auto 20rpx;
}
@keyframes cp-spin { to { transform: rotate(360deg); } }

/* 服务商列表 */
.courier-providers {
  flex: 1;
  overflow-y: auto;
  padding: 0 30rpx;
}

.courier-provider {
  background: #fafafa;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  position: relative;
}
.courier-provider.selected {
  border-color: #667eea;
  background: #f8f9ff;
}

.cp-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.cp-icon {
  width: 60rpx; height: 60rpx;
  background: #f0f0f0;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.cp-info {
  flex: 1;
  min-width: 0;
}
.cp-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}
.cp-meta {
  display: block;
  font-size: 22rpx;
  color: #999;
}
.cp-check {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  background: #667eea;
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.cp-discount {
  background: #ff5722;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.cp-pricing {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}
.cp-price-item {
  flex: 1;
  text-align: center;
}
.cp-price-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.cp-price-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ff5722;
}
.cp-price-original {
  font-size: 22rpx;
  color: #bbb;
  text-decoration: line-through;
}
.cp-discount-green {
  color: #4caf50 !important;
}

.courier-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}
.courier-empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

/* 底部确认 */
.courier-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.courier-total {
  flex: 1;
}
.courier-total-label {
  display: block;
  font-size: 22rpx;
  color: #999;
}
.courier-total-fee {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ff5722;
}
.courier-confirm-btn {
  padding: 22rpx 40rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  white-space: nowrap;
}
.courier-confirm-btn.disabled {
  opacity: 0.5;
}
.courier-confirm-btn::after {
  border: none;
}

/* 物品列表滚动区 */
.light-items-scroll {
  flex: 1;
  max-height: 480rpx;
  padding: 0 30rpx;
}

/* 物品卡片 */
.light-item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.light-item-card.light-on {
  background: #f1f8f1;
  border-color: #a5d6a7;
}

.light-item-card.checked-out {
  background: #f5f5f5;
  opacity: 0.7;
}

.light-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.light-item-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.light-item-index.lit {
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: #fff;
}

.light-item-index.done {
  background: #2196f3;
  color: #fff;
}

.light-item-info {
  flex: 1;
  min-width: 0;
}

.light-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.light-item-name.done-text {
  text-decoration: line-through;
  color: #999;
}

.light-item-price {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.light-item-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.light-item-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #4caf50, #2e7d32);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
  white-space: nowrap;
}

.light-item-btn::after {
  border: none;
}

.light-item-status {
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.light-item-status.done {
  color: #2196f3;
  font-weight: 600;
}

.light-item-status.waiting {
  color: #ff9800;
  font-size: 24rpx;
}

.light-pulse-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ff9800;
  border-radius: 50%;
  animation: lightPulse 1.2s infinite;
}

@keyframes lightPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.4); }
}

/* 已激活灯条面板 */
.light-active-panel {
  margin: 16rpx 30rpx 0;
  padding: 20rpx 24rpx;
  background: #f0faf0;
  border-radius: 16rpx;
  border: 1rpx solid #c8e6c9;
}

.light-active-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.light-active-title text:first-child {
  font-size: 26rpx;
  font-weight: 600;
  color: #2e7d32;
}

.light-active-hint {
  font-size: 22rpx;
  color: #999;
}

.light-active-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.light-active-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #333;
  border: 1rpx solid #c8e6c9;
}

.pulsing-dot {
  width: 16rpx;
  height: 16rpx;
  background: #4caf50;
  border-radius: 50%;
  animation: dotPulse 1.5s infinite;
}

@keyframes dotPulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.4); }
  50% { opacity: 0.6; box-shadow: 0 0 0 8rpx rgba(76, 175, 80, 0); }
}

/* 底部按钮 */
.light-panel-bottom {
  padding: 16rpx 30rpx 0;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}

.light-cancel-btn {
  width: 100%;
  padding: 24rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 20rpx;
  border: none;
}

.light-cancel-btn::after {
  border: none;
}

/* 扫码取件按钮样式 */
.btn-scan {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

/* ============================================ */
/* 跑腿配送跟踪样式 */
/* ============================================ */
.courier-track-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.5s ease;
  overflow: hidden;
  max-height: 500rpx;
  opacity: 1;
}

/* 已送达 → 自动收起动画 */
.courier-track-section.collapsing {
  max-height: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: 0;
  margin-bottom: 0;
  opacity: 0;
  border-radius: 0;
}

.track-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.track-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.track-status {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.track-status.picking {
  background: #fef3c7;
  color: #92400e;
}

.track-status.delivering {
  background: #dbeafe;
  color: #1e40af;
}

.track-status.delivered {
  background: #dcfce7;
  color: #166534;
}

.track-courier {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.track-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eff6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.track-detail {
  flex: 1;
}

.track-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
}

.track-meta {
  font-size: 24rpx;
  color: #6b7280;
}

.track-progress {
  padding-top: 8rpx;
}

.track-bar-bg {
  height: 8rpx;
  background: #e5e7eb;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.track-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #1e40af);
  border-radius: 4rpx;
  transition: width 1s ease;
}

.track-steps {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #9ca3af;
}

.track-steps text.active {
  color: #3b82f6;
  font-weight: 600;
}

/* 配送跟踪内的实时指示器 */
.courier-track-section .live-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}
.courier-track-section .live-dot {
  width: 14rpx;
  height: 14rpx;
  background: #4caf50;
  border-radius: 50%;
  animation: blinkPulse 1.5s infinite;
}
.courier-track-section .live-text {
  font-size: 22rpx;
  color: #4caf50;
}
@keyframes blinkPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
