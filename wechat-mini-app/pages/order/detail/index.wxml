<view class="order-detail-page">
  <!-- 扫码支付横幅 -->
  <view class="scan-pay-banner" wx:if="{{showScanPayBanner}}">
    <view class="banner-content">
      <view class="banner-icon">📱</view>
      <view class="banner-text">
        <view class="banner-title">扫码支付订单</view>
        <view class="banner-amount">¥{{scanPayAmount}}</view>
      </view>
    </view>
    <view class="banner-actions">
      <button class="banner-btn banner-btn-primary" bindtap="onScanPay">立即支付</button>
      <button class="banner-btn banner-btn-secondary" bindtap="onLaterPay">稍后支付</button>
    </view>
    <view class="banner-close" bindtap="closeScanPayBanner">
      <text class="iconfont icon-close"></text>
    </view>
  </view>

  <!-- 顶部状态卡片 -->
  <view class="status-card" style="background: {{statusConfig.gradient}}" wx:if="{{!showScanPayBanner}}">
    <!-- 返回首页按钮 -->
    <view class="home-btn" bindtap="onGoHome">
      <text class="iconfont icon-home"></text>
    </view>
    
    <view class="status-icon-large">
      <text class="iconfont icon-{{statusConfig.icon}}"></text>
    </view>
    <view class="status-text">{{statusConfig.text}}</view>
    <view class="status-desc">{{order.statusDescription}}</view>
    
    <view class="live-indicator" wx:if="{{polling}}">
      <view class="live-dot"></view>
      <text>实时更新中</text>
    </view>
  </view>

  <!-- 已入库专属卡片 -->
  <view class="warehouse-section" wx:if="{{order.status === 'received'}}">
    <view class="warehouse-header">
      <view class="warehouse-icon">📦</view>
      <view class="warehouse-title-section">
        <view class="warehouse-title">衣物已入库</view>
        <view class="warehouse-subtitle">门店已收件，等待处理中</view>
      </view>
    </view>
    <view class="warehouse-info">
      <view class="warehouse-info-row" wx:if="{{order.cleaning && order.cleaning.storeReceivedAt}}">
        <text class="warehouse-label">📅 入库时间</text>
        <text class="warehouse-value">{{formatTime(order.cleaning.storeReceivedAt)}}</text>
      </view>
      <view class="warehouse-info-row" wx:if="{{order.storeName}}">
        <text class="warehouse-label">🏪 服务网点</text>
        <text class="warehouse-value">{{order.storeName}}</text>
      </view>
      <view class="warehouse-info-row" wx:if="{{order.contactName}}">
        <text class="warehouse-label">👤 联系人</text>
        <text class="warehouse-value">{{order.contactName}}</text>
      </view>
    </view>
    <view class="warehouse-status-badge">
      <text>⏳ 等待门店分配处理</text>
    </view>
  </view>

  <!-- 配送员信息 -->
  <view class="driver-card" wx:if="{{order.delivery && (order.status === 'delivering' || order.status === 'delivering_back')}}">
    <view class="driver-avatar">
      <text class="iconfont icon-deliver"></text>
    </view>
    <view class="driver-info">
      <view class="driver-name">{{order.delivery.driverName || '配送员'}}</view>
      <view class="driver-status">{{order.status === 'delivering_back' ? '正在送回' : '正在配送中'}}</view>
    </view>
    <view class="driver-actions">
      <button class="driver-btn call" bindtap="onCallDriver">
        <text class="iconfont icon-phone"></text>
      </button>
    </view>
  </view>

  <!-- 跑腿配送跟踪（仅跑腿订单显示，实时更新，已送达自动收起） -->
  <view class="courier-track-section {{courierInfo.status === 'delivered' ? 'collapsing' : ''}}" wx:if="{{showCourierTracker && courierInfo}}">
    <view class="track-header">
      <text class="track-title">🏃 配送跟踪</text>
      <view class="track-status {{courierInfo.statusClass}}">
        <text>{{courierInfo.statusText}}</text>
      </view>
    </view>
    <view class="track-courier">
      <view class="track-avatar">🧑‍✈️</view>
      <view class="track-detail">
        <text class="track-name">{{courierInfo.name}}</text>
        <text class="track-meta">{{courierInfo.distance}} · 预计{{courierInfo.eta}}后到达</text>
      </view>
    </view>
    <view class="track-progress">
      <view class="track-bar-bg">
        <view class="track-bar-fill" style="width: {{courierInfo.progress}}%"></view>
      </view>
      <view class="track-steps">
        <text class="{{courierInfo.progress >= 0 ? 'active' : ''}}">已取件</text>
        <text class="{{courierInfo.progress >= 50 ? 'active' : ''}}">配送中</text>
        <text class="{{courierInfo.progress >= 100 ? 'active' : ''}}">已送达</text>
      </view>
    </view>
    <!-- 实时更新指示点 -->
    <view class="live-indicator" wx:if="{{courierInfo.status !== 'delivered'}}">
      <view class="live-dot"></view>
      <text class="live-text">实时跟踪中</text>
    </view>
  </view>

  <!-- 进度条 — 与C端一致：固定紫色渐变 + active/current class 控制 -->
  <view class="progress-section">
    <view class="info-title">订单进度</view>
    <view class="progress-steps">
      <view class="progress-line"></view>
      <view class="progress-line-fill" style="width: {{progressPercent}}%;"></view>
      
      <view class="progress-step {{step.active ? 'active' : ''}} {{step.current ? 'current' : ''}}" 
            wx:for="{{steps}}" 
            wx:for-item="step"
            wx:key="key">
        <view class="step-icon">
          <text class="iconfont icon-{{step.icon}}"></text>
        </view>
        <text class="step-label">{{step.text}}</text>
      </view>
    </view>
  </view>

  <!-- 取件码 -->
  <view class="pickup-code-section" wx:if="{{order.pickupCode && order.status !== 'completed'}}">
    <view class="pickup-code-label">取件码</view>
    <view class="pickup-code-value">{{order.pickupCode}}</view>
  </view>

  <!-- 取件方式选择（待取件状态） -->
  <view class="pickup-method-section" wx:if="{{showPickupMethod}}">
    <view class="pickup-method-title">请选择取件方式</view>
    
    <!-- 到店自提 -->
    <view class="pickup-method-option {{selectedPickupMethod === 'store_pickup' ? 'selected' : ''}}" 
          data-method="store_pickup"
          bindtap="onSelectPickupMethod">
      <view class="pickup-method-icon" style="background: #e8f5e9; color: #4caf50;">🏪</view>
      <view class="pickup-method-info">
        <view class="pickup-method-name">到店自提</view>
        <view class="pickup-method-desc">凭取件码到店取件，无需等待</view>
      </view>
      <view class="pickup-method-check">
        <text class="iconfont icon-check" wx:if="{{selectedPickupMethod === 'store_pickup'}}"></text>
      </view>
    </view>
    
    <!-- 配送到家 -->
    <view class="pickup-method-option {{selectedPickupMethod === 'home_delivery' ? 'selected' : ''}}" 
          data-method="home_delivery"
          bindtap="onSelectPickupMethod">
      <view class="pickup-method-icon" style="background: #e3f2fd; color: #2196f3;">🚚</view>
      <view class="pickup-method-info">
        <view class="pickup-method-name">配送到家</view>
        <view class="pickup-method-desc">骑手送件上门，方便快捷</view>
      </view>
      <view class="pickup-method-check">
        <text class="iconfont icon-check" wx:if="{{selectedPickupMethod === 'home_delivery'}}"></text>
      </view>
    </view>
    
    <!-- 配送表单 -->
    <view class="delivery-form {{selectedPickupMethod === 'home_delivery' ? 'show' : ''}}">
      <view class="form-group">
        <view class="form-label">配送地址</view>
        <input class="form-input" 
               type="text" 
               placeholder="请输入详细配送地址"
               value="{{deliveryForm.address}}"
               data-field="address"
               bindinput="onDeliveryFormInput"/>
      </view>
      <view class="form-group">
        <view class="form-label">联系人</view>
        <input class="form-input" 
               type="text" 
               placeholder="请输入联系人姓名"
               value="{{deliveryForm.contactName}}"
               data-field="contactName"
               bindinput="onDeliveryFormInput"/>
      </view>
      <view class="form-group">
        <view class="form-label">联系电话</view>
        <input class="form-input" 
               type="tel" 
               placeholder="请输入联系电话"
               value="{{deliveryForm.contactPhone}}"
               data-field="contactPhone"
               bindinput="onDeliveryFormInput"/>
      </view>
    </view>
  </view>

  <!-- 跑腿服务商选择面板 -->
  <view class="courier-panel {{showCourierPanel ? 'show' : ''}}">
    <view class="courier-panel-header">
      <view class="courier-panel-title">选择跑腿服务</view>
      <view class="courier-panel-close" bindtap="onCloseCourierPanel">
        <text class="iconfont icon-close"></text>
      </view>
    </view>

    <!-- 配送模式切换 -->
    <view class="courier-mode-tabs">
      <view class="courier-mode-tab {{deliveryMode === 'solo' ? 'active' : ''}}"
            data-mode="solo" bindtap="onSwitchDeliveryMode">
        <text class="courier-mode-name">一对一专送</text>
        <text class="courier-mode-sub">专属骑手 · 最快送达</text>
      </view>
      <view class="courier-mode-tab {{deliveryMode === 'shared' ? 'active' : ''}}"
            data-mode="shared" bindtap="onSwitchDeliveryMode">
        <text class="courier-mode-name">拼单配送</text>
        <text class="courier-mode-sub">多人分摊 · 更省钱</text>
      </view>
    </view>

    <!-- 报价加载中 -->
    <view class="courier-loading" wx:if="{{courierLoading}}">
      <view class="courier-spinner"></view>
      <text>正在获取报价...</text>
    </view>

    <!-- 服务商列表 -->
    <view class="courier-providers" wx:if="{{!courierLoading}}">
      <view class="courier-provider {{selectedCourier === item.id ? 'selected' : ''}}"
            wx:for="{{courierProviders}}" wx:key="id"
            data-provider="{{item.id}}" bindtap="onSelectCourier">
        <view class="cp-header">
          <view class="cp-icon">{{item.icon}}</view>
          <view class="cp-info">
            <text class="cp-name">{{item.name}}</text>
            <text class="cp-meta">⭐ {{item.rating}} · {{item.estimatedTime}} · {{item.distance}}km</text>
          </view>
          <view class="cp-check" wx:if="{{selectedCourier === item.id}}">✓</view>
          <view class="cp-discount" wx:elif="{{item.hasDiscount}}">{{item.discountInfo}}</view>
        </view>
        <view class="cp-pricing">
          <view class="cp-price-item">
            <text class="cp-price-label">配送费</text>
            <text class="cp-price-value">¥{{deliveryMode === 'shared' ? item.pricing.shared.actualFee : item.pricing.solo.actualFee}}</text>
            <text class="cp-price-original" wx:if="{{deliveryMode === 'solo' ? item.pricing.solo.discount > 0 : item.pricing.shared.discount > 0}}">
              ¥{{deliveryMode === 'solo' ? item.pricing.solo.originalFee : item.pricing.shared.originalFee}}
            </text>
          </view>
          <view class="cp-price-item" wx:if="{{selectedCourier === item.id && (deliveryMode === 'solo' ? item.pricing.solo.discount > 0 : item.pricing.shared.discount > 0)}}">
            <text class="cp-price-label">优惠</text>
            <text class="cp-price-value cp-discount-green">
              -¥{{deliveryMode === 'solo' ? item.pricing.solo.discount : item.pricing.shared.discount}}
            </text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="courier-empty" wx:if="{{courierProviders.length === 0}}">
        <text class="courier-empty-icon">🚫</text>
        <text>暂无可用服务商</text>
      </view>
    </view>

    <!-- 底部确认 -->
    <view class="courier-footer">
      <view class="courier-total">
        <text class="courier-total-label">配送费用</text>
        <text class="courier-total-fee">¥{{courierFee}}</text>
      </view>
      <button class="courier-confirm-btn {{selectedCourier ? '' : 'disabled'}}" 
              bindtap="onConfirmCourier"
              disabled="{{!selectedCourier}}">
        确认并支付
      </button>
    </view>
  </view>
  <view class="courier-overlay {{showCourierPanel ? 'show' : ''}}" bindtap="onCloseCourierPanel"></view>

  <!-- 物品清单 -->
  <view class="info-section">
    <view class="info-title">物品清单</view>
    <view class="item-list">
      <view class="item-card" wx:for="{{order.items}}" wx:key="index">
        <view class="item-icon">
          <text class="iconfont icon-clothes"></text>
        </view>
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view class="item-desc">状态: {{item.statusText}}</view>
        </view>
      </view>
    </view>
    <view class="info-row mt-3">
      <span class="info-label">合计</span>
      <span class="info-value" style="color:#ff5722;font-size:18px;">¥{{order.amounts.total || 0}}</span>
    </view>
  </view>

  <!-- 门店信息 -->
  <view class="info-section" wx:if="{{order.storeName}}">
    <view class="info-title">服务网点</view>
    <view class="info-row">
      <span class="info-label">门店名称</span>
      <span class="info-value">{{order.storeName}}</span>
    </view>
    <view class="info-row" wx:if="{{order.storeAddress}}">
      <span class="info-label">门店地址</span>
      <span class="info-value">{{order.storeAddress}}</span>
    </view>
    <view class="info-row" wx:if="{{order.storePhone}}">
      <span class="info-label">联系电话</span>
      <span class="info-value" style="color:#2196f3;" bindtap="onCallStore">{{order.storePhone}}</span>
    </view>
    <view class="store-actions" wx:if="{{order.status === 'ready'}}">
      <button class="store-btn" bindtap="onNavigateToStore">
        <text class="iconfont icon-location"></text>
        导航到店
      </button>
      <button class="store-btn" bindtap="onCallStore">
        <text class="iconfont icon-phone"></text>
        联系门店
      </button>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="info-section">
    <view class="info-title">订单信息</view>
    <view class="info-row">
      <span class="info-label">订单编号</span>
      <span class="info-value" bindtap="copyOrderNo">{{order.orderNo || order.orderId}}</span>
    </view>
    <view class="info-row">
      <span class="info-label">下单时间</span>
      <span class="info-value">{{formatTime(order.createdAt)}}</span>
    </view>
  </view>

  <!-- 动态时间线 -->
  <view class="info-section" wx:if="{{order.latestHistory}}">
    <view class="info-title">订单动态</view>
    <view class="timeline">
      <view class="timeline-item active">
        <view class="timeline-dot">
          <text class="iconfont icon-check"></text>
        </view>
        <view class="timeline-content">
          <view class="timeline-title">{{order.latestHistory.note}}</view>
          <view class="timeline-time">{{formatTime(order.latestHistory.time)}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 待支付状态：内嵌支付面板 -->
  <view class="pay-panel" wx:if="{{order.status === 'pending'}}">
    <!-- 遮罩 -->
    <view class="pay-panel-mask" bindtap="onClosePayPanel" wx:if="{{showPayPanel}}"></view>
    
    <!-- 支付面板内容 -->
    <view class="pay-panel-inner">
      <!-- 金额展示 -->
      <view class="pay-amount-section">
        <text class="pay-amount-label">应付金额</text>
        <view class="pay-amount-row">
          <text class="pay-amount-symbol">¥</text>
          <text class="pay-amount-value">{{order.amounts.total || 0}}</text>
        </view>
      </view>
      
      <!-- 支付方式快捷选择 -->
      <view class="pay-methods-quick">
        <view class="pay-method-item {{selectedPayMethod === 'wechat' ? 'selected' : ''}}" 
              data-method="wechat" bindtap="onSelectPayMethod">
          <view class="pay-method-icon wechat-icon">💬</view>
          <text class="pay-method-name">微信支付</text>
          <view class="pay-method-check" wx:if="{{selectedPayMethod === 'wechat'}}">✓</view>
        </view>
        <view class="pay-method-item {{selectedPayMethod === 'balance' ? 'selected' : ''}}" 
              data-method="balance" bindtap="onSelectPayMethod">
          <view class="pay-method-icon balance-icon">💰</view>
          <text class="pay-method-name">余额支付</text>
          <view class="pay-method-check" wx:if="{{selectedPayMethod === 'balance'}}">✓</view>
        </view>
      </view>
      
      <!-- 更多支付方式（展开） -->
      <view class="pay-methods-more" wx:if="{{showPayPanel}}">
        <view class="pay-method-item {{selectedPayMethod === 'alipay' ? 'selected' : ''}}" 
              data-method="alipay" bindtap="onSelectPayMethod">
          <view class="pay-method-icon alipay-icon">💙</view>
          <text class="pay-method-name">支付宝</text>
          <view class="pay-method-check" wx:if="{{selectedPayMethod === 'alipay'}}">✓</view>
        </view>
        <view class="pay-method-item {{selectedPayMethod === 'unionpay' ? 'selected' : ''}}" 
              data-method="unionpay" bindtap="onSelectPayMethod">
          <view class="pay-method-icon unionpay-icon">💳</view>
          <text class="pay-method-name">银行卡</text>
          <view class="pay-method-check" wx:if="{{selectedPayMethod === 'unionpay'}}">✓</view>
        </view>
      </view>
      
      <!-- 展开/收起更多方式 -->
      <view class="pay-toggle-more" bindtap="onTogglePayPanel">
        <text>{{showPayPanel ? '收起' : '更多支付方式'}}</text>
        <text class="toggle-arrow {{showPayPanel ? 'up' : 'down'}}">▼</text>
      </view>
      
      <!-- 支付按钮 -->
      <button class="pay-confirm-btn {{isPaying ? 'paying' : ''}}" bindtap="onConfirmPay">
        {{isPaying ? '支付中...' : '确认支付 ¥' + (order.amounts.total || 0)}}
      </button>
    </view>
  </view>

  <!-- 非待支付状态的底部操作栏 -->
  <view class="bottom-bar" wx:if="{{order.status !== 'pending'}}">
    <view class="bottom-bar-left">
      <button class="btn-action btn-outline" bindtap="onCallStore" wx:if="{{order.storePhone}}">
        联系门店
      </button>
      <button class="btn-action btn-danger btn-outline" 
              bindtap="onCancelOrder" 
              wx:if="{{order.status === 'paid'}}">
        取消订单
      </button>
      <button class="btn-action btn-warning btn-outline" 
              bindtap="onReorder" 
              wx:if="{{order.status === 'completed' || order.status === 'cancelled'}}">
        再次下单
      </button>
    </view>
    <view class="bottom-bar-right">
      <!-- 可取件状态 & 门店自提 → 扫码取件 -->
      <button class="btn-action btn-scan" 
              bindtap="onScanPickup" 
              wx:if="{{showPickupMethod && selectedPickupMethod === 'store_pickup'}}">
        📱 扫码取件
      </button>
      <!-- 可取件状态 & 配送到家 → 选择跑腿服务 -->
      <button class="btn-action btn-success" 
              bindtap="onHandleMainAction" 
              wx:if="{{showPickupMethod && selectedPickupMethod === 'home_delivery'}}">
        🚀 选择跑腿
      </button>
      <button class="btn-action btn-outline"
              bindtap="onRemind"
              wx:if="{{order.status === 'processing' || order.status === 'received' || order.status === 'cleaning' || order.status === 'cleaned'}}">
        催单
      </button>
      <button class="btn-action btn-primary" 
              bindtap="onRate" 
              wx:if="{{order.status === 'completed'}}">
        去评价
      </button>
    </view>
  </view>

  <!-- ============================================ -->
  <!-- 灯条管理窗口（底部弹出面板） -->
  <!-- ============================================ -->
  <view class="light-panel-mask {{showLightPanel ? 'show' : ''}}" bindtap="onCloseLightPanel"></view>
  <view class="light-panel {{showLightPanel ? 'show' : ''}}">
    <!-- 顶部拖拽条 -->
    <view class="light-panel-handle">
      <view class="handle-bar"></view>
    </view>

    <!-- 标题栏 -->
    <view class="light-panel-header">
      <view class="light-panel-title">
        <text>💡 扫码取件</text>
        <text class="light-panel-subtitle">点亮衣架灯条，快速定位物品</text>
      </view>
      <view class="light-panel-close" bindtap="onCloseLightPanel">
        <text>✕</text>
      </view>
    </view>

    <!-- 流程提示 -->
    <view class="light-flow-guide">
      <view class="flow-step-item">
        <view class="flow-step-num">1</view>
        <text>点亮灯条</text>
      </view>
      <view class="flow-step-arrow">→</view>
      <view class="flow-step-item">
        <view class="flow-step-num">2</view>
        <text>店员寻灯拣货</text>
      </view>
      <view class="flow-step-arrow">→</view>
      <view class="flow-step-item">
        <view class="flow-step-num">3</view>
        <text>M端操作出库</text>
      </view>
      <view class="flow-step-arrow">→</view>
      <view class="flow-step-item">
        <view class="flow-step-num">4</view>
        <text>取件完成</text>
      </view>
    </view>

    <!-- 一键点亮所有灯条 -->
    <view class="light-all-section">
      <button class="light-all-btn {{allCheckedOut ? 'completed' : (allLit ? 'all-lit' : '')}}" 
              bindtap="onLightUpAll" 
              disabled="{{allLit || allCheckedOut}}">
        <text wx:if="{{allCheckedOut}}">✅ 所有物品已出库</text>
        <text wx:elif="{{allLit}}">🟢 所有灯条已点亮</text>
        <text wx:else>💡 一键点亮所有灯条 ({{pendingLightCount}}件)</text>
      </button>
    </view>

    <!-- 物品列表 -->
    <scroll-view class="light-items-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="light-item-card {{item.checkedOut ? 'checked-out' : ''}} {{item.lightOn ? 'light-on' : ''}}" 
            wx:for="{{lightItems}}" 
            wx:key="index" 
            wx:for-index="idx">
        <view class="light-item-left">
          <view class="light-item-index {{item.checkedOut ? 'done' : (item.lightOn ? 'lit' : '')}}">
            <text wx:if="{{item.checkedOut}}">✓</text>
            <text wx:else>{{idx + 1}}</text>
          </view>
          <view class="light-item-info">
            <text class="light-item-name {{item.checkedOut ? 'done-text' : ''}}">{{item.name}}</text>
            <text class="light-item-price" wx:if="{{item.price}}">¥{{item.price}} × {{item.quantity || 1}}</text>
          </view>
        </view>
        <view class="light-item-right">
          <!-- 已出库 -->
          <text class="light-item-status done" wx:if="{{item.checkedOut}}">✓ 已出库</text>
          <!-- 灯已亮 -->
          <text class="light-item-status waiting" wx:elif="{{item.lightOn}}">
            <view class="light-pulse-dot"></view>
            等待店员...
          </text>
          <!-- 点亮按钮 -->
          <button class="light-item-btn" wx:else bindtap="onLightUpItem" data-index="{{idx}}">
            💡 亮灯取件
          </button>
        </view>
      </view>
    </scroll-view>

    <!-- 已激活灯条面板 -->
    <view class="light-active-panel" wx:if="{{activeLightItems.length > 0}}">
      <view class="light-active-title">
        <text>🟢 已激活灯条 ({{activeLightItems.length}}个)</text>
        <text class="light-active-hint">店员正在处理...</text>
      </view>
      <view class="light-active-list">
        <view class="light-active-item" wx:for="{{activeLightItems}}" wx:key="index">
          <view class="pulsing-dot"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="light-panel-bottom">
      <button class="light-cancel-btn" bindtap="onCloseLightPanel">关闭</button>
    </view>
  </view>
</view>
