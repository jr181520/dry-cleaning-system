.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}
.loading-wrap { display: flex; justify-content: center; padding: 200rpx 0; }
.text-gray { font-size: 28rpx; color: #9ca3af; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  display: block;
}

/* 地址卡片 */
.address-card {
  background: #fff;
  margin: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left: 8rpx solid #7c3aed;
}
.address-header { display: flex; gap: 20rpx; margin-bottom: 8rpx; }
.address-name { font-size: 30rpx; font-weight: 600; color: #111827; }
.address-phone { font-size: 26rpx; color: #6b7280; }
.address-detail { font-size: 26rpx; color: #4b5563; }
.address-empty-text { font-size: 28rpx; color: #9ca3af; }
.address-edit { font-size: 24rpx; color: #7c3aed; }

/* 商品卡片 */
.item-card {
  background: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.item-row { display: flex; gap: 20rpx; }
.item-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0; }
.item-meta { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.item-name { font-size: 28rpx; font-weight: 500; color: #1f2937; line-height: 1.4; }
.item-spec { font-size: 22rpx; color: #9ca3af; }
.item-price-row { display: flex; align-items: baseline; gap: 6rpx; }
.item-rate { font-size: 32rpx; font-weight: 700; color: #7c3aed; }
.item-unit { font-size: 22rpx; color: #9ca3af; }

/* 费用明细 */
.fee-section {
  background: #fff;
  margin: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
}
.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}
.fee-label { font-size: 26rpx; color: #4b5563; }
.fee-value { font-size: 26rpx; color: #1f2937; font-weight: 500; }
.fee-free { color: #059669; }
.total-row { border-top: 1rpx solid #f0f0f0; padding-top: 20rpx; margin-top: 8rpx; }
.fee-total { font-size: 36rpx; font-weight: 700; color: #7c3aed; }

/* 芝麻信用徽章 */
.zhima-section { margin: 16rpx; }
.zhima-badge {
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid #a7f3d0;
}
.zhima-icon { font-size: 48rpx; }
.zhima-info { flex: 1; }
.zhima-title { font-size: 28rpx; font-weight: 600; color: #059669; display: block; }
.zhima-score { font-size: 22rpx; color: #047857; display: block; margin-top: 4rpx; }
.zhima-status { font-size: 36rpx; color: #059669; font-weight: 700; }

/* 支付方式 */
.pay-section {
  background: #fff;
  margin: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
}
.pay-method {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.pay-icon-wrap { display: flex; align-items: center; gap: 16rpx; }
.pay-icon { font-size: 36rpx; }
.pay-name { font-size: 28rpx; color: #1f2937; }
.pay-hint { font-size: 22rpx; color: #9ca3af; }
.pay-check { font-size: 32rpx; color: #1677ff; font-weight: 700; }
.pay-arrow { font-size: 36rpx; color: #9ca3af; }

/* 底部 */
.bottom-placeholder { height: 140rpx; }
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.bar-label { font-size: 24rpx; color: #6b7280; }
.bar-total { font-size: 44rpx; font-weight: 700; color: #7c3aed; }
.bar-btn {
  background: #1677ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 60rpx;
  border-radius: 44rpx;
}
.bar-btn.disabled { opacity: 0.6; }
