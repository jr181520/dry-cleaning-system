<view class="page" a:if="{{!loading && order}}">
  <!-- 状态横幅 -->
  <view class="status-banner {{statusInfo.gradient}}">
    <text class="status-label">{{statusInfo.label}}</text>
    <text class="status-order">订单号：{{order.orderNo || orderNo}}</text>
  </view>

  <!-- 倒计时区域 -->
  <view class="countdown-section" a:if="{{order.status === 'using' || order.status === 'due' || order.status === 'overdue'}}">
    <view class="countdown-card">
      <view class="countdown-row">
        <text class="countdown-label">剩余租期</text>
        <view class="countdown-value">
          <text class="countdown-num {{isOverdue ? 'overdue' : ''}}">{{isOverdue ? '已逾期' : remainingDays + '天'}}</text>
        </view>
      </view>
      <view class="countdown-row" a:if="{{dueDate}}">
        <text class="countdown-label">到期日期</text>
        <text class="countdown-date">{{dueDate}}</text>
      </view>
    </view>
  </view>

  <!-- 租赁商品 -->
  <view class="section">
    <text class="section-title">租赁商品</text>
    <view a:for="{{order.items || []}}" a:for-item="ri" key="{{ri.itemId || ri._id}}" class="rental-item">
      <image class="rental-img" src="{{ri.image || '/assets/placeholder.png'}}" mode="aspectFill" />
      <view class="rental-meta">
        <text class="rental-name">{{ri.name || ri.itemName}}</text>
        <text class="rental-spec" a:if="{{ri.spec}}">{{ri.spec}}</text>
        <text class="rental-qty">x{{ri.quantity || 1}}</text>
      </view>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="section">
    <text class="section-title">费用明细</text>
    <view class="fee-row">
      <text class="fee-label">租赁费</text>
      <text class="fee-value">¥{{order.rentalFee || 0}}</text>
    </view>
    <view class="fee-row" a:if="{{order.depositFee > 0}}">
      <text class="fee-label">押金</text>
      <text class="fee-value">¥{{order.depositFee}}</text>
    </view>
    <view class="fee-row" a:if="{{order.depositMode === 'credit_free'}}">
      <text class="fee-label">押金（信用免押）</text>
      <text class="fee-value fee-free">¥0</text>
    </view>
    <view class="fee-row" a:if="{{order.overdueFee > 0}}">
      <text class="fee-label">逾期费</text>
      <text class="fee-value fee-warn">¥{{order.overdueFee}}</text>
    </view>
    <view class="fee-row total-row">
      <text class="fee-label">合计</text>
      <text class="fee-value fee-total">¥{{order.totalFee || order.totalAmount || 0}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <text class="section-title">订单信息</text>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.orderNo || orderNo}}</text>
    </view>
    <view class="info-row" a:if="{{order.createdAt}}">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createdAt}}</text>
    </view>
    <view class="info-row" a:if="{{order.rentalDays}}">
      <text class="info-label">租赁时长</text>
      <text class="info-value">{{order.rentalDays}}天</text>
    </view>
    <view class="info-row">
      <text class="info-label">押金方式</text>
      <text class="info-value">{{order.depositMode === 'credit_free' ? '芝麻信用免押' : order.depositMode === 'both' ? '免押可选' : '缴纳押金'}}</text>
    </view>
  </view>

  <!-- 芝麻信用徽章 -->
  <view class="section" a:if="{{order.depositMode === 'credit_free'}}">
    <view class="zhima-card">
      <view class="zhima-row">
        <text class="zhima-icon">🛡️</text>
        <view class="zhima-info">
          <text class="zhima-title">芝麻信用免押</text>
          <text class="zhima-desc" a:if="{{zhimaLevel}}">芝麻分{{zhimaScore}} · {{zhimaLevel.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部操作按钮 -->
  <view class="action-bar" a:if="{{order.status === 'shipped' || order.status === 'using' || order.status === 'due' || order.status === 'overdue' || order.status === 'reserved'}}">
    <view class="action-btn btn-cancel" a:if="{{order.status === 'reserved'}}" onTap="onCancel">取消订单</view>
    <view class="action-btn btn-green" a:if="{{order.status === 'shipped'}}" onTap="onConfirmReceive">确认收货</view>
    <view class="action-btn btn-primary" a:if="{{order.status === 'using' || order.status === 'due' || order.status === 'overdue'}}" onTap="onReturn">发起归还</view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-wrap" a:if="{{loading}}">
  <text class="text-gray">加载中...</text>
</view>
