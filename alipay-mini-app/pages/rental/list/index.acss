.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input {
  height: 72rpx;
  background: #f3f4f6;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

/* 品类筛选 */
.category-scroll {
  background: #fff;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}
.category-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}
.tab-item {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #f3f4f6;
  color: #374151;
}
.tab-item.active {
  background: #7c3aed;
  color: #fff;
}

/* 双列网格 */
.item-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 16rpx;
  gap: 16rpx;
}
.item-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.item-image {
  width: 100%;
  height: 340rpx;
}
.item-info {
  padding: 16rpx 20rpx 20rpx;
}
.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}
.item-brand {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  display: block;
}
.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.item-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #7c3aed;
}
.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #9ca3af;
}

/* 押金标签 */
.deposit-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.deposit-tag.deposit {
  background: #fef3c7;
  color: #92400e;
}
.deposit-tag.credit_free {
  background: #dbeafe;
  color: #1e40af;
}
.deposit-tag.both {
  background: #ede9fe;
  color: #7c3aed;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-state-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 加载/无更多 */
.loading, .no-more {
  text-align: center;
  padding: 40rpx 0;
}
.text-gray {
  font-size: 26rpx;
  color: #9ca3af;
}
