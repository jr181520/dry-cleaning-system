.container { display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; padding: 0 60rpx; background: linear-gradient(180deg, #e6f7ff 0%, #fff 50%); }
.logo-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 100rpx; }
.logo { width: 160rpx; height: 160rpx; margin-bottom: 30rpx; }
.app-name { font-size: 48rpx; font-weight: bold; color: #333; }
.login-section { width: 100%; }
.alipay-btn { width: 100%; height: 100rpx; background: #1677ff; color: #fff; border-radius: 50rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; border: none; box-shadow: 0 8rpx 30rpx rgba(22,119,255,0.3); }
.btn-icon { font-size: 40rpx; margin-right: 15rpx; }
.divider { display: flex; align-items: center; margin: 60rpx 0; }
.line { flex: 1; height: 2rpx; background: #e8e8e8; }
.or-text { padding: 0 30rpx; color: #999; font-size: 28rpx; }
.phone-btn { width: 100%; height: 100rpx; background: #fff; color: #1677ff; border: 2rpx solid #1677ff; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; }
.agreement-section { margin-top: 60rpx; }
.agreement-label { display: flex; align-items: center; }
.agreement-text { font-size: 24rpx; color: #666; margin-left: 10rpx; }
.link { color: #1677ff; }
