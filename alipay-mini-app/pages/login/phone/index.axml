<view class="container">
  <view class="form-section">
    <text class="title">手机号登录</text>
    <text class="subtitle">输入手机号，获取验证码</text>

    <view class="input-group">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        onInput="onPhoneInput"
      />
    </view>

    <view class="input-group">
      <text class="label">验证码</text>
      <view class="code-row">
        <input
          class="input code-input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          value="{{code}}"
          onInput="onCodeInput"
        />
        <button
          class="send-btn {{canSend ? '' : 'disabled'}}"
          disabled="{{!canSend}}"
          onTap="onSendCode"
        >{{sendBtnText}}</button>
      </view>
    </view>

    <button class="login-btn" onTap="onSubmit">登录 / 注册</button>

    <view class="hint-row">
      <text class="hint">开发环境：任意6位数字即可登录</text>
    </view>
  </view>
</view>