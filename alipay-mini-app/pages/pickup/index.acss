.container { padding: 40rpx; }
.scan-section { display: flex; justify-content: center; align-items: center; padding: 100rpx 0; }
.scan-button { width: 300rpx; height: 300rpx; border-radius: 50%; background: linear-gradient(135deg, #1677ff, #0958d9); display: flex; flex-direction: column; justify-content: center; align-items: center; box-shadow: 0 8rpx 30rpx rgba(22,119,255,0.3); }
.scan-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.scan-text { color: #fff; font-size: 32rpx; font-weight: bold; }
.input-section { margin-top: 60rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: bold; margin-bottom: 30rpx; }
.code-input { width: 100%; padding: 30rpx; border: 2rpx solid #e8e8e8; border-radius: 12rpx; font-size: 32rpx; text-align: center; letter-spacing: 10rpx; margin-bottom: 30rpx; }
.verify-btn { width: 100%; background: #1677ff; color: #fff; border-radius: 12rpx; font-size: 32rpx; padding: 30rpx 0; border: none; }
.recent-section { margin-top: 60rpx; }
.pickup-list { display: flex; flex-direction: column; }
.pickup-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; background: #fff; border-radius: 12rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.pickup-info { flex: 1; }
.pickup-no { display: block; font-size: 30rpx; font-weight: bold; margin-bottom: 10rpx; }
.pickup-time { display: block; font-size: 24rpx; color: #999; }
.pickup-status { color: #52c41a; font-size: 28rpx; }
