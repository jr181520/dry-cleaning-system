.container { padding: 20rpx; }
.search-bar { display: flex; align-items: center; padding: 20rpx; background: #f5f5f5; border-radius: 40rpx; margin-bottom: 20rpx; }
.search-icon { font-size: 32rpx; margin-right: 10rpx; }
.search-text { color: #999; font-size: 28rpx; }
.banner { height: 300rpx; border-radius: 16rpx; overflow: hidden; margin-bottom: 20rpx; }
.banner image { width: 100%; height: 100%; }
.pickup-notice { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; background: #fff7e6; border-radius: 12rpx; margin-bottom: 20rpx; }
.pickup-notice .arrow { font-size: 40rpx; color: #fa8c16; }
.category-grid { display: flex; flex-wrap: wrap; justify-content: space-around; padding: 20rpx 0; }
.category-item { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 30rpx; }
.category-icon { width: 100rpx; height: 100rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 48rpx; margin-bottom: 10rpx; }
.category-name { font-size: 24rpx; color: #333; }
.section { margin-top: 40rpx; }
.section-title { font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx; display: block; }
.service-list { display: flex; flex-wrap: wrap; justify-content: space-between; }
.service-card { width: 48%; background: #fff; border-radius: 12rpx; overflow: hidden; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.service-card image { width: 100%; height: 200rpx; }
.service-name { display: block; padding: 15rpx; font-size: 28rpx; }
.service-price { display: block; padding: 0 15rpx 15rpx; color: #1677ff; font-size: 32rpx; font-weight: bold; }
.store-list { display: flex; flex-direction: column; }
.store-card { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; background: #fff; border-radius: 12rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.store-info { flex: 1; }
.store-name { display: block; font-size: 30rpx; font-weight: bold; margin-bottom: 10rpx; }
.store-address { display: block; font-size: 24rpx; color: #999; }
.store-distance { color: #1677ff; font-size: 28rpx; }
