<view class="container">
  <view class="user-card" a:if="{{userInfo}}">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="info-text">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="phone">{{userInfo.phone || '未绑定手机'}}</text>
      </view>
      <view class="edit-btn" onTap="onEditTap">
        <text>编辑</text>
      </view>
    </view>
    <view class="zhima-badge" a:if="{{zhimaScore >= 600}}">
      <text class="zhima-icon">🌟</text>
      <text class="zhima-text">芝麻信用 {{zhimaScore}}</text>
    </view>
  </view>

  <view class="login-card" a:if="{{!userInfo}}" onTap="onLoginTap">
    <text>点击登录</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" a:for="{{menuItems}}" key="name" onTap="onMenuTap" data-url="{{item.url}}">
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
