<view class="container">
  <view class="success-section">
    <view class="success-icon">
      <text>✓</text>
    </view>
    <text class="success-title">下单成功</text>
    <text class="success-desc" a:if="{{orderNo}}">订单号：{{orderNo}}</text>
  </view>

  <view class="action-section">
    <button class="view-btn" onTap="onViewOrderTap">查看订单</button>
    <button class="home-btn" onTap="onHomeTap">返回首页</button>
  </view>
</view>
