.container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; padding: 0 60rpx; }
.success-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 100rpx; }
.success-icon { width: 160rpx; height: 160rpx; border-radius: 50%; background: #52c41a; display: flex; align-items: center; justify-content: center; margin-bottom: 40rpx; box-shadow: 0 8rpx 30rpx rgba(82,196,26,0.3); }
.success-icon text { font-size: 100rpx; color: #fff; font-weight: bold; }
.success-title { font-size: 48rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.success-desc { font-size: 28rpx; color: #999; }
.action-section { width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.view-btn { width: 100%; height: 100rpx; background: #1677ff; color: #fff; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; border: none; box-shadow: 0 8rpx 30rpx rgba(22,119,255,0.3); }
.home-btn { width: 100%; height: 100rpx; background: #fff; color: #1677ff; border: 2rpx solid #1677ff; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; }
