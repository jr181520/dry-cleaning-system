.container { padding: 20rpx; }
.method-list { display: flex; flex-direction: column; margin-bottom: 30rpx; }
.method-card { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 12rpx; padding: 40rpx 30rpx; margin-bottom: 20rpx; border: 2rpx solid #e8e8e8; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.method-card.selected { border-color: #1677ff; background: #e6f7ff; }
.method-info { display: flex; align-items: center; }
.method-icon { font-size: 60rpx; margin-right: 20rpx; }
.method-text { display: flex; flex-direction: column; }
.method-name { font-size: 32rpx; font-weight: bold; margin-bottom: 10rpx; }
.method-desc { font-size: 26rpx; color: #999; }
.check-icon { width: 50rpx; height: 50rpx; border-radius: 50%; border: 2rpx solid #e8e8e8; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #999; }
.check-icon.checked { background: #1677ff; color: #fff; border-color: #1677ff; }
.address-section { background: #fff; border-radius: 12rpx; padding: 30rpx; margin-bottom: 30rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.section-title { display: block; font-size: 32rpx; font-weight: bold; margin-bottom: 30rpx; }
.address-form { display: flex; flex-direction: column; }
.input { width: 100%; padding: 25rpx; border: 2rpx solid #e8e8e8; border-radius: 8rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.submit-btn { width: 100%; height: 100rpx; background: #1677ff; color: #fff; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; border: none; box-shadow: 0 8rpx 30rpx rgba(22,119,255,0.3); }
