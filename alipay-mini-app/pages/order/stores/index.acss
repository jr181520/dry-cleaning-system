.container { padding: 20rpx; }
.search-bar { margin-bottom: 20rpx; }
.search-input { width: 100%; padding: 25rpx; background: #fff; border: 2rpx solid #e8e8e8; border-radius: 12rpx; font-size: 28rpx; }
.store-list { display: flex; flex-direction: column; }
.store-card { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 12rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.store-info { flex: 1; }
.store-name { display: block; font-size: 32rpx; font-weight: bold; margin-bottom: 10rpx; }
.store-address { display: block; font-size: 26rpx; color: #999; margin-bottom: 15rpx; }
.store-meta { display: flex; align-items: center; }
.store-rating { font-size: 26rpx; color: #faad14; }
.distance-badge { background: #e6f7ff; color: #1677ff; padding: 15rpx 25rpx; border-radius: 30rpx; font-size: 26rpx; }
.empty { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }
