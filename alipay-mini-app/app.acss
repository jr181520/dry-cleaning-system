page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 通用按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.btn-primary {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #ffffff;
}
.btn-primary:active { opacity: 0.85; }
.btn-success {
  background: linear-gradient(135deg, #059669 0%, #10b981 100%);
  color: #ffffff;
}
.btn-warning {
  background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
  color: #ffffff;
}
.btn-danger {
  background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
  color: #ffffff;
}
.btn-ghost {
  background: transparent;
  border: 2rpx solid #1677ff;
  color: #1677ff;
}
.btn-sm {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}
.section-subtitle {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

/* 输入框 */
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #ffffff;
}

/* 状态标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-pending { background: #fef3c7; color: #92400e; }
.tag-processing { background: #dbeafe; color: #1e40af; }
.tag-ready { background: #d1fae5; color: #065f46; }
.tag-completed { background: #f3f4f6; color: #374151; }
.tag-cancelled { background: #fee2e2; color: #991b1b; }
.tag-rental { background: #ede9fe; color: #6d28d9; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-state-icon {
  font-size: 120rpx;
  color: #d1d5db;
  margin-bottom: 32rpx;
}
.empty-state-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 加载 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1677ff;
  margin: 0 8rpx;
}

/* 动画 */
.fade-in { opacity: 1; }

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 24rpx 0;
}

/* 工具类 */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }
.text-primary { color: #1677ff; }
.text-success { color: #059669; }
.text-warning { color: #d97706; }
.text-danger { color: #dc2626; }
.text-gray { color: #6b7280; }
.text-bold { font-weight: 600; }

.bg-primary { background-color: #1677ff; }
.bg-success { background-color: #059669; }

.mt-4 { margin-top: 16rpx; }
.mt-6 { margin-top: 24rpx; }
.mt-8 { margin-top: 32rpx; }
.mb-4 { margin-bottom: 16rpx; }
.mb-6 { margin-bottom: 24rpx; }
.mb-8 { margin-bottom: 32rpx; }
.p-4 { padding: 16rpx; }
.p-6 { padding: 24rpx; }
.p-8 { padding: 32rpx; }

.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }

.gap-2 { gap: 8rpx; }
.gap-4 { gap: 16rpx; }
.gap-6 { gap: 24rpx; }

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
